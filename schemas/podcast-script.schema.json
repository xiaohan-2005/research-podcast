{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Podcast Script",
  "type": "array",
  "minItems": 2,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["speaker", "text", "source_ids", "claim_type"],
    "properties": {
      "speaker": {"enum": ["A", "B"]},
      "text": {"type": "string", "minLength": 1},
      "source_ids": {
        "type": "array",
        "items": {"type": "string", "pattern": "^S[0-9]{2,}$"},
        "uniqueItems": true
      },
      "claim_type": {
        "enum": ["fact", "interpretation", "question", "transition"]
      }
    }
  }
}
